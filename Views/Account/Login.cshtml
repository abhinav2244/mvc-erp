@model mvc_erp.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ERP Portal - Login</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>

<body>

    <div class="login-page">

        <!-- Background decorations -->
        <div class="background-shape shape-one"></div>
        <div class="background-shape shape-two"></div>
        <div class="background-dots"></div>


        <div class="login-wrapper">

            <!-- LEFT INFORMATION PANEL -->

            <div class="welcome-section">

                <div class="brand">

                    <div class="brand-icon">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>

                    <div>
                        <span class="brand-title">ERP</span>
                        <span class="brand-subtitle">PORTAL</span>
                    </div>

                </div>


                <div class="welcome-content">

                    <span class="welcome-label">
                        WELCOME BACK
                    </span>

                    <h1>
                        Your Campus.<br />
                        <span>One Platform.</span>
                    </h1>

                    <p>
                        Manage academics, examinations, students,
                        faculty and campus activities from one
                        centralized platform.
                    </p>

                    <div class="feature-list">

                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>

                            <div>
                                <strong>Academic Management</strong>
                                <small>Manage your academic activities</small>
                            </div>
                        </div>


                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>

                            <div>
                                <strong>Smart Administration</strong>
                                <small>Everything in one place</small>
                            </div>
                        </div>

                    </div>

                </div>


                <div class="welcome-footer">
                    <span>
                        <i class="fa-regular fa-circle-check"></i>
                        Secure ERP Access
                    </span>

                    <span>
                        <i class="fa-solid fa-shield-halved"></i>
                        Protected Login
                    </span>
                </div>

            </div>


            <!-- LOGIN SECTION -->

            <div class="login-section">

                <div class="login-card">

                    <div class="mobile-brand">
                        <div class="brand-icon">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>

                        <span>ERP PORTAL</span>
                    </div>


                    <div class="login-heading">

                        <span class="heading-icon">
                            <i class="fa-solid fa-lock"></i>
                        </span>

                        <div>
                            <h2>Sign in</h2>
                            <p>Access your ERP account</p>
                        </div>

                    </div>


                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          id="loginForm">


                        <!-- USERNAME -->

                        <div class="form-group">

                            <label asp-for="Username">
                                Username
                            </label>

                            <div class="input-wrapper">

                                <i class="fa-regular fa-user input-icon"></i>

                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Enter your username"
                                       autocomplete="username" />

                            </div>

                            <span asp-validation-for="Username"
                                  class="field-error">
                            </span>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <div class="password-label">

                                <label asp-for="Password">
                                    Password
                                </label>

                                <a href="#" class="forgot-link">
                                    Forgot password?
                                </a>

                            </div>


                            <div class="input-wrapper">

                                <i class="fa-solid fa-key input-icon"></i>

                                <input asp-for="Password"
                                       class="form-control password-input"
                                       placeholder="Enter your password"
                                       autocomplete="current-password" />

                                <button type="button"
                                        class="password-toggle"
                                        id="togglePassword"
                                        aria-label="Show password">

                                    <i class="fa-regular fa-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="field-error">
                            </span>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button type="submit"
                                class="login-button"
                                id="loginButton">

                            <span class="button-text">
                                Sign in
                            </span>

                            <span class="button-loader">
                                <i class="fa-solid fa-circle-notch fa-spin"></i>
                                Signing in...
                            </span>

                            <i class="fa-solid fa-arrow-right button-arrow"></i>

                        </button>


                        <!-- EXTRA LINKS -->

                        <div class="quick-links">

                            <a href="#">
                                <i class="fa-solid fa-user-plus"></i>
                                Student Registration
                            </a>

                            <a href="#">
                                <i class="fa-solid fa-address-card"></i>
                                Regular Registration
                            </a>

                        </div>

                    </form>

                   
                    @if (ViewBag.LoginMessage != null)
                    {
                        <script>
                            alert('@ViewBag.LoginMessage');
                        </script>
                    }
                   


                    <div class="login-footer">

                        <span>
                            © @DateTime.Now.Year ERP Portal
                        </span>

                        <span class="footer-divider"></span>

                        <span>
                            Secure & Reliable
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <script src="~/js/login.js"
            asp-append-version="true"></script>

</body>

</html>
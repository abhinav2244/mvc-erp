@model mvc_erp.Services.ExaminationDashboard.ExaminationDashboardModels.ExaminationDashboardViewModel;


@{
    ViewData["Title"] = "Examination Dashboard";
}

<div class="exam-dashboard">

    <div class="exam-dashboard-container">

        <section class="exam-overview-section">

            <div class="exam-section-heading">
                <div>
                    <h2>Exam Overview</h2>
                    <p>Current examination statistics</p>
                </div>
            </div>


            <div class="exam-stat-grid">

                <!-- Total Exams -->
                <div class="exam-stat-card">

                    <div class="exam-stat-icon exam-stat-icon-total">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>

                    <div class="exam-stat-content">

                        <span class="exam-stat-label">
                            Total Exams
                        </span>

                        <strong class="exam-stat-value">
                            @Model.ExamOverview.TotalExams
                        </strong>

                        <span class="exam-stat-description">
                            All examinations
                        </span>

                    </div>

                </div>


                <!-- Active Exams -->
                <div class="exam-stat-card">

                    <div class="exam-stat-icon exam-stat-icon-active">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div class="exam-stat-content">

                        <span class="exam-stat-label">
                            Active Exams
                        </span>

                        <strong class="exam-stat-value">
                            @Model.ExamOverview.ActiveExams
                        </strong>

                        <span class="exam-stat-description">
                            Currently active
                        </span>

                    </div>

                </div>


                <!-- Regular Exams -->
                <div class="exam-stat-card">

                    <div class="exam-stat-icon exam-stat-icon-regular">
                        <i class="fa-solid fa-file-circle-check"></i>
                    </div>

                    <div class="exam-stat-content">

                        <span class="exam-stat-label">
                            Regular Exams
                        </span>

                        <strong class="exam-stat-value">
                            @Model.ExamOverview.RegularExams
                        </strong>

                        <span class="exam-stat-description">
                            Regular assessment
                        </span>

                    </div>

                </div>


                <!-- Backlog Exams -->
                <div class="exam-stat-card">

                    <div class="exam-stat-icon exam-stat-icon-backlog">
                        <i class="fa-solid fa-arrow-rotate-left"></i>
                    </div>

                    <div class="exam-stat-content">

                        <span class="exam-stat-label">
                            Backlog Exams
                        </span>

                        <strong class="exam-stat-value">
                            @Model.ExamOverview.BacklogExams
                        </strong>

                        <span class="exam-stat-description">
                            Backlog assessment
                        </span>

                    </div>

                </div>


                <!-- Re-Exams -->
                <div class="exam-stat-card">

                    <div class="exam-stat-icon exam-stat-icon-reexam">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </div>

                    <div class="exam-stat-content">

                        <span class="exam-stat-label">
                            Re-Exams
                        </span>

                        <strong class="exam-stat-value">
                            @Model.ExamOverview.ReExam
                        </strong>

                        <span class="exam-stat-description">
                            Re-examination
                        </span>

                    </div>

                </div>

            </div>

        </section>

        <!-- =========================================================
        MY SCHEDULES
        ========================================================= -->

        <section class="schedule-section">

            <div class="schedule-card">

                <!-- Section Header -->
                <div class="schedule-header">

                    <div class="schedule-header-left">

                        <div class="schedule-header-icon">
                            <i class="fa fa-calendar"></i>
                        </div>

                        <div>
                            <h2 class="schedule-title">My Schedules</h2>
                            <p class="schedule-subtitle">
                                Keep track of your upcoming events and activities
                            </p>
                        </div>

                    </div>


                    <!-- Add Event button -->
                    <button type="button"
                            class="schedule-add-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#addEventModal">
                        <i class="fa fa-plus"></i>
                        Add Event
                    </button>

                </div>


                <div class="schedule-body">

                    <!-- =================================================
                         CALENDAR
                         ================================================= -->

                    <div class="schedule-calendar">

                        <div class="calendar-top">

                            <h3 class="calendar-month" id="calendarMonth">
                                September 2026
                            </h3>

                            <div class="calendar-actions">

                                <button type="button"
                                        class="calendar-btn"
                                        id="previousMonth">
                                    <i class="fa fa-chevron-left"></i>
                                </button>

                                <button type="button"
                                        class="calendar-btn"
                                        id="nextMonth">
                                    <i class="fa fa-chevron-right"></i>
                                </button>

                            </div>

                        </div>


                        <!-- Week Days -->

                        <div class="calendar-weekdays">

                            <div class="calendar-weekday">Sun</div>
                            <div class="calendar-weekday">Mon</div>
                            <div class="calendar-weekday">Tue</div>
                            <div class="calendar-weekday">Wed</div>
                            <div class="calendar-weekday">Thu</div>
                            <div class="calendar-weekday">Fri</div>
                            <div class="calendar-weekday">Sat</div>

                        </div>


                        <!-- Calendar Days -->

                        <div class="calendar-days" id="calendarDays">
                        </div>

                    </div>


                    <!-- =================================================
                         UPCOMING SCHEDULES
                         ================================================= -->

                    <div class="schedule-list">

                        <div class="schedule-list-header">

                            <h3 class="schedule-list-title">
                                Upcoming Events
                            </h3>

                            <span class="schedule-count">
                                @Model.ScheduleEvents.Count
                            </span>

                        </div>


                        <div class="schedule-items">

                            @if (Model.ScheduleEvents != null &&
                                                        Model.ScheduleEvents.Any())
                            {
                                foreach (var item in Model.ScheduleEvents
                                .Where(x => x.EventDate.HasValue)
                                .OrderBy(x => x.EventDate)
                                .Take(10))
                                {
                                    <div class="schedule-item">

                                        <div class="schedule-item-marker"
                                             style="background:@(string.IsNullOrWhiteSpace(item.Color) ? "#315f8c" : item.Color)">
                                        </div>

                                        <div class="schedule-item-content">

                                            <h4 class="schedule-item-title">
                                                @(string.IsNullOrWhiteSpace(item.EventName)
                                                                                        ? "Untitled Event"
                                                                                        : item.EventName)
                                                                                                     </h4>

                                            <p class="schedule-item-description">
                                                @(string.IsNullOrWhiteSpace(item.EventDesc)
                                                                                        ? "No description available"
                                                                                        : item.EventDesc)
                                    </p>

                                            <div class="schedule-item-meta">

                                                <span class="schedule-meta">
                                                    <i class="fa fa-calendar"></i>
                                                    @item.EventDate.Value.ToString("dd MMM yyyy")
                                                </span>

                                        @if (item.FromTime.HasValue && item.ToTime.HasValue)
                                                {
                                                    <span class="schedule-meta">
                                                        <i class="fa fa-clock-o"></i>
                                                        @DateTime.Today.Add(item.FromTime.Value).ToString("hh:mm tt")
                                                        -
                                                        @DateTime.Today.Add(item.ToTime.Value).ToString("hh:mm tt")
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.EventType))
                                                {
                                                    <span class="schedule-meta">
                                                        <i class="fa fa-tag"></i>
                                                        @item.EventType
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        @if (item.EventId.HasValue)
                                        {
                                            <button type="button"
                                                    class="schedule-delete-btn"
                                                    title="Delete Event"
                                                    onclick="deleteScheduleEvent(@item.EventId.Value)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="schedule-empty">

                                    <div class="schedule-empty-icon">
                                        <i class="fa fa-calendar-o"></i>
                                    </div>

                                    <h4 class="schedule-empty-title">
                                        No schedules available
                                    </h4>

                                    <p class="schedule-empty-text">
                                        Your upcoming events will appear here.
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <div class="modal fade"
     id="addEventModal"
     tabindex="-1"
     aria-labelledby="addEventModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <!--
                The form submits the event details to the
                ExaminationDashboardController AddEvent action.
            -->
            <form asp-controller="ExaminationDashboard"
                  asp-action="AddEvent"
                  method="post">

                <!-- Modal Header -->
                <div class="modal-header">

                    <div>
                        <h5 class="modal-title" id="addEventModalLabel">
                            Add Event
                        </h5>

                        <p class="mb-0 text-muted">
                            Create a new schedule event
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- Modal Body -->
                <div class="modal-body">

                    <div class="row g-3">

                        <!-- Event Title -->
                        <div class="col-md-12">

                            <label for="eventTitle"
                                   class="form-label">
                                Event Title
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="eventTitle"
                                   name="EventName"
                                   placeholder="Enter event title"
                                   required />

                        </div>


                        <!-- Event Date -->
                        <div class="col-md-4">

                            <label for="eventDate"
                                   class="form-label">
                                Date
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="eventDate"
                                   name="EventDate"
                                   required />

                        </div>


                        <!-- Start Time -->
                        <div class="col-md-4">

                            <label for="eventFromTime"
                                   class="form-label">
                                Start Time
                            </label>

                            <input type="time"
                                   class="form-control"
                                   id="eventFromTime"
                                   name="FromTime"
                                   required />

                        </div>


                        <!-- End Time -->
                        <div class="col-md-4">

                            <label for="eventToTime"
                                   class="form-label">
                                End Time
                            </label>

                            <input type="time"
                                   class="form-control"
                                   id="eventToTime"
                                   name="ToTime"
                                   required />

                        </div>


                        <!-- Description -->
                        <div class="col-md-12">

                            <label for="eventDescription"
                                   class="form-label">
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="eventDescription"
                                      name="EventDesc"
                                      rows="3"
                                      placeholder="Enter event description"
                                      required></textarea>

                        </div>


                        <!-- Color -->
                        <div class="col-md-6">

                            <label for="eventColor"
                                   class="form-label">
                                Color
                            </label>

                            <input type="color"
                                   class="form-control form-control-color"
                                   id="eventColor"
                                   name="Color"
                                   value="#315f8c" />

                        </div>

                    </div>

                </div>


                <!-- Modal Footer -->
                <div class="modal-footer">

                    <!-- Close modal without submitting -->
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>


                    <!--
                        type="submit" is important.
                        This sends the form data to AddEvent().
                    -->
                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa fa-plus"></i>
                        Add Event

                    </button>

                </div>

            </form>

        </div>

    </div>
</div>

    </div>

</div>

<script>

    // Run the calendar code only after the complete HTML page
    // has been loaded by the browser.
    document.addEventListener("DOMContentLoaded", function () {

        // Stores the month currently being displayed.
        // Initially, it is set to the current date/month.
        let currentDate = new Date();

        // Schedule data received from MVC.
    // Color is taken from the database/SP result.
    const scheduleEvents = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.ScheduleEvents)
        );
        // Names of all months.
        // JavaScript getMonth() returns values from 0 to 11,
        // where 0 = January and 11 = December.
        const monthNames = [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
        ];


        // Get the HTML element where the current month/year
        // will be displayed.
        const calendarMonth =
            document.getElementById("calendarMonth");


        // Get the HTML element where all calendar day cells
        // will be generated.
        const calendarDays =
            document.getElementById("calendarDays");


        // This function creates and displays the calendar
        // for the month stored in currentDate.
        function renderCalendar() {

            // Get the year from the currently selected date.
            const year = currentDate.getFullYear();


            // Get the month number.
            // January = 0, February = 1, ..., December = 11.
            const month = currentDate.getMonth();


            // Display the month name and year in the calendar header.
            // Example: "September 2026"
            calendarMonth.textContent =
                monthNames[month] + " " + year;


            // Clear the previously generated calendar days.
            // This is necessary when moving to another month.
            calendarDays.innerHTML = "";


            // Find the day of the week on which the current month starts.
            //
            // getDay() returns:
            // 0 = Sunday
            // 1 = Monday
            // 2 = Tuesday
            // ...
            // 6 = Saturday
            const firstDay =
                new Date(year, month, 1).getDay();


            // Find how many days are present in the current month.
            //
            // Using day 0 of the next month gives us
            // the last day of the current month.
            const daysInMonth =
                new Date(year, month + 1, 0).getDate();


            // Create empty calendar cells before the first day
            // of the month.
            //
            // Example:
            // If the month starts on Wednesday, we need
            // empty cells for Sunday, Monday and Tuesday.
            for (let i = 0; i < firstDay; i++) {

                // Create a new div for the empty cell.
                const emptyDay =
                    document.createElement("div");


                // Add the CSS classes used for an empty calendar cell.
                emptyDay.className =
                    "calendar-day empty";


                // Add the empty cell to the calendar.
                calendarDays.appendChild(emptyDay);
            }


            // Get today's date.
            // This is used to highlight today's calendar cell.
            const today = new Date();


            // Create one calendar cell for every day
            // in the current month.
            for (let day = 1; day <= daysInMonth; day++) {

                // Create a new div element for the day.
                const dayElement =
                    document.createElement("div");


                // Add the CSS class used by normal calendar days.
                dayElement.className =
                    "calendar-day";


                // Display the day number inside the cell.
                // Example: 1, 2, 3, 4...
                dayElement.textContent = day;


                // Check whether this day is today's date.
                //
                // We compare:
                // - Day
                // - Month
                // - Year
                //
                // This prevents the same day number in another
                // month/year from being highlighted.
                if (
                    day === today.getDate() &&
                    month === today.getMonth() &&
                    year === today.getFullYear()
                ) {

                    // Add the "today" CSS class.
                    // Your CSS can use this class to highlight today.
                    dayElement.classList.add("today");
                }


                // Add the generated day cell to the calendar.
                calendarDays.appendChild(dayElement);
            }
        }


        // Handle the Previous Month button.
        document
            .getElementById("previousMonth")
            .addEventListener("click", function () {

                // Move the current date one month backwards.
                //
                // For example:
                // September 2026 → August 2026
                currentDate.setMonth(
                    currentDate.getMonth() - 1
                );


                // Rebuild the calendar using the new month.
                renderCalendar();
            });


        // Handle the Next Month button.
        document
            .getElementById("nextMonth")
            .addEventListener("click", function () {

                // Move the current date one month forward.
                //
                // For example:
                // September 2026 → October 2026
                currentDate.setMonth(
                    currentDate.getMonth() + 1
                );


                // Rebuild the calendar using the new month.
                renderCalendar();
            });


        // Render the calendar for the current month
        // when the page is opened.
        renderCalendar();

    });

</script>
